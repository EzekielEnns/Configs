+/** A stopped worker's interim text and what it read, for its notes file. */
+function trail(messages: Message[]): string {
+	const said: string[] = [];
+	const looked: string[] = [];
+	for (const msg of messages) {
+		if (msg.role !== "assistant") continue;
+		for (const part of msg.content) {
+			if (part.type === "text" && part.text.trim()) said.push(part.text.trim());
+			if (part.type === "toolCall") {
+				const a = part.arguments as Record<string, unknown>;
+				const what = a.path ? `${a.path}${a.offset ? `:${a.offset}` : ""}` : "";
+				looked.push(`- ${part.name} ${[a.pattern, what, a.command].filter(Boolean).join(" ").slice(0, 160)}`);
+			}
+		}
+	}
+	const text = said.join("\n\n").slice(-4000);
+	return `${text || "(it wrote no text)"}\n\n## Tool calls\n${looked.join("\n") || "(none)"}`;
+}
